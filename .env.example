# ============================================
# Servidor
# ============================================
PORT=4000
NODE_ENV=development

# ============================================
# Base de datos PostgreSQL (Render/Railway/Supabase)
# ============================================
DATABASE_URL="postgresql://usuario:password@host:5432/gacielbol_db?schema=public"

# ============================================
# Autenticación JWT
# ============================================
JWT_SECRET="cambia_este_secreto_por_uno_seguro_y_largo"
JWT_EXPIRES_IN="8h"

# ============================================
# Parámetros tributarios aduaneros
# ============================================
TIPO_CAMBIO_DEFAULT=6.96
ALICUOTA_IVA=14.94

# ============================================
# Supabase API (opcional, para cliente móvil/Auth)
# NUNCA subas SUPABASE_SECRET_KEY a GitHub
# ============================================
SUPABASE_URL="https://TU_PROYECTO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://TU_PROYECTO.supabase.co/auth/v1/.well-known/jwks.json"