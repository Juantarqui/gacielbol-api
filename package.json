{
  "name": "gacielbol-api",
  "version": "1.0.0",
  "description": "API RESTful para el Sistema de Gestión y Liquidación de Impuestos Aduaneros - Grupo Logístico Gacielbol SRL (Bolivia)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
